<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ReleaseVersion>2.1.0.0</ReleaseVersion>
	<Description>A class library for querying and manipulating Microsoft SQL databases.</Description>
	<PackageTags>Galactic;sql;database;mssql</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="System.Data.SqlClient" />
    <None Remove="Microsoft.SqlServer.SqlManagementObjects" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.SqlClient" Version="6.0.2" />
    <PackageReference Include="Microsoft.SqlServer.SqlManagementObjects" Version="172.76.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Galactic.Sql\Galactic.Sql.csproj" />
  </ItemGroup>
</Project>
