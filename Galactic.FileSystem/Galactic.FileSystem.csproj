<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ReleaseVersion>2.1.0.0</ReleaseVersion>
	<Description>A class library for common file system operations including inheritance and permissions.</Description>
	<PackageTags>Galactic;file;directory;permissions;inheritance</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="System.Security.AccessControl" />
    <None Remove="System.DirectoryServices" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="System.DirectoryServices" Version="9.0.7" />
    <PackageReference Include="System.Security.AccessControl" Version="6.0.1" />
  </ItemGroup>
</Project>
